# Get these values from the project's Connect dialog in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin used for redirects and the browser Eden client.
# Use http://localhost:3000 locally and your production origin in deployment.
NEXT_PUBLIC_APP_URL=

# Server-only. Legacy service_role JWT or new sb_secret_... key.
# Get it from Supabase Dashboard -> Project Settings -> API.
# Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Generate with:
# node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))"
API_KEY_PEPPER=
